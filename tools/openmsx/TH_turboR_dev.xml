<?xml version="1.0" ?>
<!DOCTYPE msxconfig SYSTEM 'msxconfig2.dtd'>
<!--
  TrolleyHomeRun 開発用機種。C-BIOS(無償)を turbo R のハード(R800 + S1990)で動かす。
  - C-BIOS には CHGCPU(0180h)が無い。ローダーは MSXVER<3 かつ S1990 ありのときだけ S1990 を直接書いて R800 DRAM にする。
  - 速度は「エミュレータ参考値」。最終確認は実機相当(FS-A1ST / FS-A1GT のファーム)で行う。
-->
<msxconfig>
  <info>
    <manufacturer>C-BIOS</manufacturer>
    <code>turboR TH dev (C-BIOS hybrid, RAM 3-0)</code>
    <release_year>2026</release_year>
    <description>C-BIOS on MSXturboR hardware (R800 + S1990) with RAM in slot 3-0 like FS-A1ST. For TrolleyHomeRun development.</description>
    <type>MSXturboR</type>
    <region>jp</region>
  </info>

  <MapperReadBackBits>largest</MapperReadBackBits>

  <devices>

    <primary slot="0">
      <ROM id="C-BIOS Main ROM JP">
        <mem base="0x0000" size="0x8000"/>
        <rom>
          <sha1>a5b02ea4a1530f2b96f0f4f4e2049f0de4a31e5a</sha1>
          <filename>cbios_main_msx2+_jp.rom</filename>
        </rom>
      </ROM>
      <ROM id="C-BIOS Logo ROM">
        <mem base="0x8000" size="0x4000"/>
        <rom>
          <sha1>db2635ef7e3f8589518dca65f2e3b515edc5372d</sha1>
          <filename>cbios_logo_msx2+.rom</filename>
        </rom>
      </ROM>
    </primary>

    <primary external="true" slot="1"/>
    <primary external="true" slot="2"/>

    <primary slot="3">
      <!-- openMSX の R800 は 3-0 だけを「内蔵 RAM」として追加ウェイト無しで扱う。
           それ以外の内蔵スロットは ROM 扱いでメモリアクセスごとに +1 サイクル(src/cpu/R800.hh)。
           CBIOS_turboR は RAM が 3-2 にあり、R800 が実機より 2〜3 倍遅く測れた(TurboRVoxelShooter と同じ知見)。 -->
      <secondary slot="0">
        <!-- FS-A1ST と同じ 256KB -->
        <PanasonicRAM id="Main RAM">
          <mem base="0x0000" size="0x10000"/>
          <size>256</size>
        </PanasonicRAM>
      </secondary>
      <secondary slot="1">
        <ROM id="C-BIOS Sub ROM">
          <mem base="0x0000" size="0x4000"/>
          <rom>
            <sha1>2fcb40413e7d373f0f2dbdc815ce18746ddf3684</sha1>
            <filename>cbios_sub.rom</filename>
          </rom>
        </ROM>
      </secondary>
    </primary>

    <S1990 id="S1990">
      <io base="0xE4" num="2"/>
    </S1990>

    <PPI id="ppi">
      <io base="0xA8" num="4"/>
      <sound><volume>16000</volume></sound>
      <keyboard_type>jp_ansi</keyboard_type>
      <has_keypad>true</has_keypad>
      <code_kana_locks>true</code_kana_locks>
      <graph_locks>false</graph_locks>
    </PPI>

    <VDP id="VDP">
      <io base="0x98" num="4" type="O"/>
      <io base="0x98" num="2" type="I"/>
      <version>V9958</version>
      <vram>128</vram>
    </VDP>

    <PSG id="PSG">
      <type>YM2149</type>
      <keyboardlayout>50on</keyboardlayout>
      <io base="0xA0" num="4" type="IO"/>
      <sound><volume>21000</volume></sound>
    </PSG>

    <E6Timer id="Turbo-R timer">
      <io base="0xE6" num="2"/>
    </E6Timer>

    <ResetStatusRegister id="Reset Status register">
      <io base="0xF4" num="1"/>
      <inverted>false</inverted>
    </ResetStatusRegister>

    <TurboRPause id="TurboRPause">
      <io base="0xA7" num="1"/>
    </TurboRPause>

  </devices>
</msxconfig>
